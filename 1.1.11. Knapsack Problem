#include <stdio.h>
#include <stdlib.h>
int max(int a, int b) {
return (a > b) ? a : b;
}

int knapsack(int n, int values[], int weights[], int W) {

int *dp = (int *)calloc(W + 1, sizeof(int));
if (dp == NULL) return 0;
for (int i = 0; i < n; i++) {
for (int w = W; w >= weights[i]; w--) {
dp[w] = max(dp[w], values[i] + dp[w - weights[i]]);
}
}
int result = dp[W];
free(dp);
return result;
}
int main() {
int n, W;
if (scanf("%d", &n) != 1) return 0;
int *values = (int *)malloc(n * sizeof(int));
int *weights = (int *)malloc(n * sizeof(int));
for (int i = 0; i < n; i++) {
if (scanf("%d", &values[i]) != 1) return 0;
}
	for (int i = 0; i < n; i++) {
if (scanf("%d", &weights[i]) != 1) return 0;
    }
	if (scanf("%d", &W) != 1) return 0;
printf("%d\n", knapsack(n, values, weights, W));

free(values);
free(weights);
return 0;
}
